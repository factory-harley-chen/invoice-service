# Values for ./demo.sh. Copy to demo/.env (git-ignored) and fill in:
#   cp values.example.env demo/.env
# Never commit demo/.env and never paste its values into a chat.
# A variable set in the shell overrides the file (handy for test ports).

# Invoice monitor Slack app in factory-gtm: OAuth & Permissions,
# "Bot User OAuth Token" (starts with xoxb-). Secret.
SLACK_BOT_TOKEN=

# Channel ids, not names (channel details, bottom of the About tab, "C0...").
# Both channels are private.
SLACK_CHANNEL_LIVE=
SLACK_CHANNEL_REHEARSAL=
SLACK_WORKSPACE_URL=https://factory-gtm.slack.com

GITHUB_REPO=factory-harley-chen/invoice-service
# The code owner who approves, and the login the run's pull requests come from.
OWNER_LOGIN=factory-harley-chen
BOT_LOGIN=factory-droid[bot]

# Who the Factory run acts as: invoice-oncall (a service account) or
# org-default (the Factory Demos default service account). Undecided; see SETUP.md P5.
RUN_IDENTITY=

STAGING_PORT=4100
LOOP_PORT=4200

# Loop screen only. The name on the approval station, and the CI check name and
# review check patterns it watches. The defaults fit the current workflows;
# change them if smoke test S5 shows other check names.
OWNER_NAME=Harley
CHECK_TESTS="Lint, typecheck and test"
CHECK_CODE_REVIEW="droid.?review|code.?review"
CHECK_SECURITY_REVIEW="security"

# rehearsal or live; ./demo.sh up --mode overrides it.
DEMO_MODE=rehearsal

# Private key of the write deploy key that ./demo.sh reset --yes uses to
# force-push demo-baseline to main (SETUP.md P3). The path, not the key.
RESET_DEPLOY_KEY=~/.ssh/invoice-service-reset
